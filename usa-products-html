    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f5f9ff;
            color: #101828;
        }

        /* HEADER */

        .header {
            background: #ffffff;
            border-bottom: 1px solid #e5eaf1;
            padding: 15px 18px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .header-inner {
            max-width: 1100px;
            margin: auto;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo {
            width: 43px;
            height: 43px;
            background: #ffc928;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-size: 21px;
        }

        .brand h1 {
            color: #0757d9;
            font-size: 19px;
        }

        .brand p {
            color: #667085;
            font-size: 11px;
            margin-top: 3px;
        }

        /* CONTAINER */

        .container {
            width: min(1100px, 100%);
            margin: auto;
            padding: 25px 15px 45px;
        }

        /* TITLE */

        .title {
            margin-bottom: 22px;
        }

        .title h2 {
            font-size: 24px;
            margin-bottom: 6px;
        }

        .title p {
            color: #667085;
            font-size: 13px;
        }

        /* PRODUCTS */

        .products {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }

        .product {
            background: #ffffff;
            border: 1px solid #e5eaf1;
            border-radius: 14px;
            padding: 10px;
            text-decoration: none;
            color: #101828;
            transition: .2s;
            overflow: hidden;
        }

        .product:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(7, 87, 217, .10);
            border-color: #cbdcff;
        }

        .product-name {
            font-size: 12px;
            font-weight: 700;
            line-height: 1.3;
            min-height: 32px;
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }

        .product-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            border-radius: 10px;
            overflow: hidden;
            background: #f1f5f9;
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* BACK */

        .back {
            display: block;
            width: fit-content;
            margin: 25px auto 0;
            color: #0757d9;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

        .back:hover {
            text-decoration: underline;
        }

        /* TABLET */

        @media (max-width: 800px) {

            .products {
                grid-template-columns: repeat(4, 1fr);
                gap: 10px;
            }

            .product {
                padding: 8px;
            }

            .product-name {
                font-size: 11px;
            }

        }

        /* PHONE */

        @media (max-width: 600px) {

            .container {
                padding: 20px 10px 40px;
            }

            .products {
                grid-template-columns: repeat(3, 1fr);
                gap: 9px;
            }

            .product {
                padding: 7px;
                border-radius: 11px;
            }

            .product-name {
                font-size: 10px;
                min-height: 30px;
                margin-bottom: 6px;
            }

            .product-image {
                border-radius: 8px;
            }

        }

    </style>

</head>

